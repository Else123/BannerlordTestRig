<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="15.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <!-- Test-rig scenario module for cross-mod checks. NOT part of any mod build or solution: the TestRig
       runner builds AutoTrader, CompanionSuite and the harness first with the same /p:BannerlordModulesPath,
       so the referenced mod DLLs below come from that stage folder. -->
  <Import Project="..\..\..\src\Directory.Build.props" />
  <Import Project="$(MSBuildExtensionsPath)\$(MSBuildToolsVersion)\Microsoft.Common.props" Condition="Exists('$(MSBuildExtensionsPath)\$(MSBuildToolsVersion)\Microsoft.Common.props')" />
  <PropertyGroup>
    <!-- MCM (Mod Configuration Menu) workshop assemblies, derived from the Steam library as in the mod repos. -->
    <McmBinPath Condition="'$(McmBinPath)' == ''">$(BannerlordPath)\..\..\workshop\content\261550\2859238197\bin\Win64_Shipping_Client</McmBinPath>
  </PropertyGroup>
  <PropertyGroup>
    <Configuration Condition=" '$(Configuration)' == '' ">Debug</Configuration>
    <Platform Condition=" '$(Platform)' == '' ">x64</Platform>
    <ProjectGuid>{A149C6C7-A47A-4CF8-A084-FCE46051C188}</ProjectGuid>
    <OutputType>Library</OutputType>
    <RootNamespace>CrossMod.Scenarios</RootNamespace>
    <AssemblyName>CrossMod.Scenarios</AssemblyName>
    <TargetFrameworkVersion>v4.8</TargetFrameworkVersion>
    <FileAlignment>512</FileAlignment>
    <Deterministic>true</Deterministic>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(Platform)' == 'Debug|x64'">
    <DebugSymbols>true</DebugSymbols>
    <OutputPath>bin\x64\Debug\</OutputPath>
    <DefineConstants>DEBUG;TRACE</DefineConstants>
    <DebugType>full</DebugType>
    <PlatformTarget>x64</PlatformTarget>
    <LangVersion>7.3</LangVersion>
    <ErrorReport>prompt</ErrorReport>
    <Prefer32Bit>false</Prefer32Bit>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(Platform)' == 'Release|x64'">
    <OutputPath>bin\x64\Release\</OutputPath>
    <DefineConstants>TRACE</DefineConstants>
    <Optimize>true</Optimize>
    <DebugType>pdbonly</DebugType>
    <PlatformTarget>x64</PlatformTarget>
    <LangVersion>7.3</LangVersion>
    <ErrorReport>prompt</ErrorReport>
    <Prefer32Bit>false</Prefer32Bit>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="System" />
    <Reference Include="System.Core" />
    <!-- Staged by the runner's earlier build steps (same BannerlordModulesPath). -->
    <Reference Include="AutoTrader">
      <HintPath>$(BannerlordModulesPath)\AutoTraderSpeed\bin\Win64_Shipping_Client\AutoTrader.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="CompanionSuite">
      <HintPath>$(BannerlordModulesPath)\CompanionManagementSuite\bin\Win64_Shipping_Client\CompanionSuite.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="TestRig.Harness">
      <HintPath>$(BannerlordModulesPath)\TestRig.Harness\bin\Win64_Shipping_Client\TestRig.Harness.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="MCMv5">
      <HintPath>$(McmBinPath)\MCMv5.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="TaleWorlds.CampaignSystem">
      <HintPath>$(BannerlordBinPath)\TaleWorlds.CampaignSystem.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="TaleWorlds.Core">
      <HintPath>$(BannerlordBinPath)\TaleWorlds.Core.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="TaleWorlds.Engine">
      <HintPath>$(BannerlordBinPath)\TaleWorlds.Engine.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="TaleWorlds.Library">
      <HintPath>$(BannerlordBinPath)\TaleWorlds.Library.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="TaleWorlds.Localization">
      <HintPath>$(BannerlordBinPath)\TaleWorlds.Localization.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="TaleWorlds.MountAndBlade">
      <HintPath>$(BannerlordBinPath)\TaleWorlds.MountAndBlade.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="TaleWorlds.ObjectSystem">
      <HintPath>$(BannerlordBinPath)\TaleWorlds.ObjectSystem.dll</HintPath>
      <Private>False</Private>
    </Reference>
  </ItemGroup>
  <ItemGroup>
    <Compile Include="CrossModSubModule.cs" />
    <Compile Include="TradeWithAutoEquipScenario.cs" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="SubModule.xml">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>
  <Import Project="$(MSBuildToolsPath)\Microsoft.CSharp.targets" />
  <Target Name="CopyToBannerlord" AfterTargets="Build">
    <PropertyGroup>
      <ModOutputPath>$(BannerlordModulesPath)\CrossMod.Scenarios</ModOutputPath>
    </PropertyGroup>
    <MakeDir Directories="$(ModOutputPath);$(ModOutputPath)\bin\Win64_Shipping_Client" />
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(ModOutputPath)\bin\Win64_Shipping_Client" />
    <Copy SourceFiles="$(TargetDir)$(TargetName).pdb" DestinationFolder="$(ModOutputPath)\bin\Win64_Shipping_Client" Condition="Exists('$(TargetDir)$(TargetName).pdb')" />
    <Copy SourceFiles="$(ProjectDir)SubModule.xml" DestinationFiles="$(ModOutputPath)\SubModule.xml" />
    <Message Text="Deployed cross-mod scenarios to $(ModOutputPath)" Importance="high" />
  </Target>
</Project>
